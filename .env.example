# AICP Environment Variables
# Copy this file to .env and adjust as needed.
# .env is gitignored — never commit your actual values.

# ── Default behavior ──────────────────────────────────────────────────────────
# Default permission mode for all tasks: think | edit | act
AICP_DEFAULT_MODE=think

# Default AI backend: local | claude | auto
AICP_DEFAULT_BACKEND=local

# Default project directory (leave unset to use cwd)
# AICP_PROJECT_PATH=/path/to/your/project

# ── Storage ───────────────────────────────────────────────────────────────────
# AICP home directory (history, project registry, global skills, user config)
# Defaults to ~/.aicp
# AICP_HOME=/home/youruser/.aicp

# Override history directory only (defaults to $AICP_HOME/history)
# AICP_HISTORY_DIR=/home/youruser/.aicp/history

# Structured JSON-line event log (JSONL). When set, every completed task appends
# one compact JSON line to this file (no response body — use history files for that).
# Useful for shipping logs to a SIEM, running jq queries, or feeding Grafana/Loki.
# AICP_LOG_FILE=/var/log/aicp/events.jsonl

# SQLite metrics database. When set, every completed task is also recorded in the
# database for fast aggregation queries. Use make db-rebuild to populate from
# existing history files. Query with: sqlite3 $AICP_DB_FILE
#   SELECT backend, COUNT(*), AVG(duration_seconds) FROM tasks GROUP BY backend;
# AICP_DB_FILE=~/.aicp/metrics.db

# User-level config override: ~/.aicp/config.yaml is merged on top of
# config/default.yaml. Use it for machine-specific settings (model name,
# base_url, max_tokens) without touching the committed config file.
# Example ~/.aicp/config.yaml:
#   backends:
#     local:
#       model: phi3-mini
#       max_tokens: 4096

# ── LocalAI ───────────────────────────────────────────────────────────────────
# LocalAI API base URL (must match docker-compose port mapping)
# AICP_LOCAL_BASE_URL=http://localhost:8090

# API key for LocalAI (must match LOCALAI_API_KEY in docker-compose env).
# Leave empty to disable auth. Useful when exposing LocalAI on a network.
# LOCALAI_API_KEY=

# Parallel inference slots for llama.cpp (default: 4)
# LLAMACPP_PARALLEL=4

# ── Agent daemon ─────────────────────────────────────────────────────────────
# Secret for HMAC-signed agent API requests
# AICP_AGENT_SECRET=change-me-to-a-random-secret

# Port for aicp-agent daemon (default: 9100)
# AICP_AGENT_PORT=9100

# ── LocalAI P2P (auto-generated by make fleet-init) ────────────────────────
# Shared token for LocalAI P2P federation (all nodes must use the same token)
# LOCALAI_P2P_TOKEN=<auto-generated>

# Network ID groups nodes into a logical cluster (default: aicp-fleet)
# LOCALAI_P2P_NETWORK_ID=aicp-fleet
OPENROUTER_API_KEY=
OLLAMA_API_KEY=