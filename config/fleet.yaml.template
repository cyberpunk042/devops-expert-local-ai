# Fleet topology template — copy to config/fleet.yaml and edit
# Generated by: make fleet-init
#
# Machine 1 (mining-station): 8GB VRAM single GPU
# Machine 2 (workstation-jfm): 8GB + 11GB VRAM dual GPU
#
# Each machine runs:
#   - LocalAI container (GPU inference)
#   - AICP agent daemon (port 9100)
#   - Shared fleet token for authentication
#
# Cluster peering: machines route tasks to each other based on
# model availability and free VRAM via aicp/core/cluster.py
fleet:
  # Shared secret — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
  token: CHANGE_ME
  port: 9100

  nodes:
    # ── Machine 1: Single GPU (8GB) ──
    - name: mining-station
      host: 192.168.40.10
      port: 9100
      role: primary
      # Models: qwen3-8b (Q4_K_M), qwen3-4b (Q6_K), nomic-embed, bge-reranker
      # VRAM budget: ~6GB model + ~2GB KV cache

    # ── Machine 2: Dual GPU (8GB + 11GB = 19GB) ──
    - name: workstation-jfm
      host: 192.168.40.250
      port: 9100
      role: worker
      # Models: qwen3-30b-a3b (Q4_K_M), qwen3-8b, nomic-embed, bge-reranker
      # VRAM budget: ~17GB model + ~2GB KV cache
      # docker-compose needs: device_ids: ["0", "1"]
      # Model YAML needs: tensor_split: "0.42,0.58"
