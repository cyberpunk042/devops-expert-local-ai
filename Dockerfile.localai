# Pinned version — update deliberately after testing: make setup-force
# To upgrade: change the version tag here, then run: make setup-force
FROM localai/localai:v4.1.3-gpu-nvidia-cuda-12

# Backends extracted from quay.io OCI images via scripts/extract-backend.sh.
# Staged to /aicp-backends/ at build time, then copied into the /backends
# volume at runtime by entrypoint.sh (the base image declares /backends
# as a VOLUME, so build-time COPY into /backends/ is overridden at runtime).
COPY backends/cuda12-llama-cpp /aicp-backends/cuda12-llama-cpp
COPY backends/whisper /aicp-backends/whisper
COPY backends/piper /aicp-backends/piper

# Rebuilt stablediffusion-ggml backend (sd.cpp @ 8afbeb6 with CUDA).
# Gallery OCI image ships stale libgosd*.so without SD 3.5 support.
# Built by: make build-libgosd (called automatically during make setup if CUDA available)
# Dir may be empty if CUDA not available — entrypoint skips empty patches.
COPY backends/cuda12-stablediffusion-ggml-rebuild /aicp-backends/cuda12-stablediffusion-ggml-rebuild

COPY scripts/entrypoint.sh /aicp-entrypoint.sh
ENTRYPOINT ["/aicp-entrypoint.sh"]
